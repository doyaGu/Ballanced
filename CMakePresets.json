{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-win32-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "msvc-x64-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "ballance-runtime-msvc-win32",
      "displayName": "Ballance Runtime (MSVC Win32)",
      "description": "Build the standard Ballance runtime layout with shared DLL modules.",
      "inherits": "msvc-win32-base",
      "cacheVariables": {
        "BALLANCE_BUILD_STATIC_PLAYER": "OFF"
      }
    },
    {
      "name": "ballance-runtime-msvc-x64",
      "displayName": "Ballance Runtime (MSVC x64)",
      "description": "Build the x64 Ballance runtime layout with shared DLL modules.",
      "inherits": "msvc-x64-base",
      "cacheVariables": {
        "BALLANCE_BUILD_STATIC_PLAYER": "OFF"
      }
    },
    {
      "name": "ballance-static-player-msvc-win32",
      "displayName": "Ballance Static Player (MSVC Win32)",
      "description": "Build Player with Virtools modules linked statically.",
      "inherits": "msvc-win32-base",
      "cacheVariables": {
        "BALLANCE_BUILD_STATIC_PLAYER": "ON"
      }
    },
    {
      "name": "ballance-static-player-msvc-x64",
      "displayName": "Ballance Static Player (MSVC x64)",
      "description": "Build x64 Player with Virtools modules linked statically.",
      "inherits": "msvc-x64-base",
      "cacheVariables": {
        "BALLANCE_BUILD_STATIC_PLAYER": "ON"
      }
    },
    {
      "name": "ballance-runtime-tests-msvc-win32",
      "displayName": "Ballance Runtime Tests (MSVC Win32)",
      "description": "Build the shared runtime plus module test targets.",
      "inherits": "ballance-runtime-msvc-win32",
      "cacheVariables": {
        "CK2_BUILD_TESTS": "ON",
        "VXMATH_BUILD_TESTS": "ON",
        "CKRE_BUILD_TESTS": "ON",
        "CKPLUGINS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ballance-runtime-tests-msvc-x64",
      "displayName": "Ballance Runtime Tests (MSVC x64)",
      "description": "Build the x64 shared runtime plus module test targets.",
      "inherits": "ballance-runtime-msvc-x64",
      "cacheVariables": {
        "CK2_BUILD_TESTS": "ON",
        "VXMATH_BUILD_TESTS": "ON",
        "CKRE_BUILD_TESTS": "ON",
        "CKPLUGINS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ballance-runtime-win32-release",
      "displayName": "Ballance Runtime Win32 Release",
      "configurePreset": "ballance-runtime-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "ballance-runtime-x64-release",
      "displayName": "Ballance Runtime x64 Release",
      "configurePreset": "ballance-runtime-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "ballance-runtime-win32-stage-release",
      "displayName": "Ballance Runtime Win32 Stage Release",
      "configurePreset": "ballance-runtime-msvc-win32",
      "configuration": "Release",
      "targets": [
        "stage"
      ]
    },
    {
      "name": "ballance-runtime-x64-stage-release",
      "displayName": "Ballance Runtime x64 Stage Release",
      "configurePreset": "ballance-runtime-msvc-x64",
      "configuration": "Release",
      "targets": [
        "stage"
      ]
    },
    {
      "name": "ballance-static-player-win32-release",
      "displayName": "Ballance Static Player Win32 Release",
      "configurePreset": "ballance-static-player-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "ballance-static-player-x64-release",
      "displayName": "Ballance Static Player x64 Release",
      "configurePreset": "ballance-static-player-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "ballance-static-player-win32-stage-release",
      "displayName": "Ballance Static Player Win32 Stage Release",
      "configurePreset": "ballance-static-player-msvc-win32",
      "configuration": "Release",
      "targets": [
        "stage"
      ]
    },
    {
      "name": "ballance-static-player-x64-stage-release",
      "displayName": "Ballance Static Player x64 Stage Release",
      "configurePreset": "ballance-static-player-msvc-x64",
      "configuration": "Release",
      "targets": [
        "stage"
      ]
    },
    {
      "name": "ballance-runtime-tests-win32-release",
      "displayName": "Ballance Runtime Tests Win32 Release",
      "configurePreset": "ballance-runtime-tests-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "ballance-runtime-tests-x64-release",
      "displayName": "Ballance Runtime Tests x64 Release",
      "configurePreset": "ballance-runtime-tests-msvc-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "ballance-runtime-win32-stage-release",
      "displayName": "Ballance Runtime Win32 Stage Tests Release",
      "configurePreset": "ballance-runtime-msvc-win32",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ballance-runtime-x64-stage-release",
      "displayName": "Ballance Runtime x64 Stage Tests Release",
      "configurePreset": "ballance-runtime-msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ballance-runtime-tests-win32-release",
      "displayName": "Ballance Runtime Module Tests Win32 Release",
      "configurePreset": "ballance-runtime-tests-msvc-win32",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ballance-runtime-tests-x64-release",
      "displayName": "Ballance Runtime Module Tests x64 Release",
      "configurePreset": "ballance-runtime-tests-msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
