# Runs after Runtime installation. Only installed copies are modified, including
# when --prefix installs into the temporary snapshot used by the stage target.
function(_ballance_relocate_macos_sdl)
    set(_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
    find_program(_otool otool REQUIRED)
    find_program(_install_name_tool install_name_tool REQUIRED)
    find_program(_codesign codesign REQUIRED)

    file(GLOB _candidates LIST_DIRECTORIES FALSE
            "${_root}/Bin/libSDL3*.dylib" "${_root}/Bin/SDL3*.dylib")
    set(_sdl_files "")
    foreach (_candidate IN LISTS _candidates)
        if (NOT IS_SYMLINK "${_candidate}")
            list(APPEND _sdl_files "${_candidate}")
        endif ()
    endforeach ()
    list(LENGTH _sdl_files _count)
    if (NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected one installed SDL3 dylib to relocate, found ${_count}")
    endif ()
    list(GET _sdl_files 0 _sdl_path)
    get_filename_component(_sdl_name "${_sdl_path}" NAME)
    set(_install_name "@rpath/${_sdl_name}")
    execute_process(COMMAND "${_otool}" -D "${_sdl_path}"
            OUTPUT_VARIABLE _id_output COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" _id_lines "${_id_output}")
    list(FILTER _id_lines EXCLUDE REGEX "^$")
    list(GET _id_lines -1 _original_id)
    string(STRIP "${_original_id}" _original_id)

    set(_binaries "${_root}/Bin/Player")
    foreach (_directory IN ITEMS Bin RenderEngines Managers Plugins BuildingBlocks)
        file(GLOB _libraries LIST_DIRECTORIES FALSE "${_root}/${_directory}/*.dylib")
        list(APPEND _binaries ${_libraries})
    endforeach ()
    foreach (_binary IN LISTS _binaries)
        if (IS_SYMLINK "${_binary}")
            continue()
        endif ()
        set(_changes "")
        if (_binary STREQUAL _sdl_path)
            if (NOT _original_id STREQUAL _install_name)
                list(APPEND _changes -id "${_install_name}")
            endif ()
        else ()
            execute_process(COMMAND "${_otool}" -L "${_binary}"
                    OUTPUT_VARIABLE _dependencies COMMAND_ERROR_IS_FATAL ANY)
            string(REPLACE "\n" ";" _lines "${_dependencies}")
            set(_old_names "")
            foreach (_line IN LISTS _lines)
                # Read the whole name, including spaces in package prefixes.
                if (_line MATCHES "^[\t ]+(.+) \\(compatibility version ")
                    set(_dependency "${CMAKE_MATCH_1}")
                    get_filename_component(_name "${_dependency}" NAME)
                    if ((_name STREQUAL _sdl_name OR _dependency STREQUAL _original_id) AND
                            NOT _dependency STREQUAL _install_name)
                        list(APPEND _old_names "${_dependency}")
                    endif ()
                endif ()
            endforeach ()
            list(REMOVE_DUPLICATES _old_names)
            foreach (_old_name IN LISTS _old_names)
                list(APPEND _changes -change "${_old_name}" "${_install_name}")
            endforeach ()
        endif ()
        if (_changes)
            message(STATUS "[Runtime] Relocating SDL3 in ${_binary}")
            execute_process(COMMAND "${_install_name_tool}" ${_changes} "${_binary}"
                    COMMAND_ERROR_IS_FATAL ANY)
            # Editing load commands invalidates the existing Mach-O signature.
            execute_process(COMMAND "${_codesign}" --force --sign - "${_binary}"
                    COMMAND_ERROR_IS_FATAL ANY)
        endif ()
    endforeach ()
endfunction()

_ballance_relocate_macos_sdl()
