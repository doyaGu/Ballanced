if (NOT EXISTS "${TEST_SOURCE_DIR}/.git")
    message(STATUS "Numerical isolation requires a Git checkout")
    return()
endif ()

find_package(Git REQUIRED)
execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${TEST_SOURCE_DIR}" ls-files --recurse-submodules -- Source
        RESULT_VARIABLE result
        OUTPUT_VARIABLE paths
        ERROR_VARIABLE error)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect numerical ownership: ${error}")
endif ()
string(REPLACE "\r\n" "\n" paths "${paths}")
string(REPLACE "\n" ";" paths "${paths}")

set(issues)
set(checked 0)
foreach (path IN LISTS paths)
    if (NOT path MATCHES "\\.(h|hpp|hxx|inl|cpp|cxx|cmake)$" AND NOT path MATCHES "(^|/)CMakeLists\\.txt$")
        continue()
    endif ()
    if (path MATCHES "^Source/VxMath/" OR path MATCHES "^Source/BuildingBlocks/physics_RT/ivp/")
        continue()
    endif ()
    if (path MATCHES "(^|/)(tests|tools|deps|third_party)/")
        continue()
    endif ()
    file(READ "${TEST_SOURCE_DIR}/${path}" source)
    if (source MATCHES "(^|[^A-Za-z0-9_])(VXMATH_ENABLE_X87_EMULATION|IVP_ENABLE_X87_EMULATION|VxFloat80[A-Za-z0-9_]*|VxFloatContext|VxFloatPrecision|VxFloatRounding|IVP_X87_[A-Za-z0-9_]+|IVP_U_Float80|ivu_x87)([^A-Za-z0-9_]|$)")
        list(APPEND issues "${path}: ${CMAKE_MATCH_2}")
    endif ()
    math(EXPR checked "${checked} + 1")
endforeach ()
if (issues)
    list(JOIN issues "\n" details)
    message(FATAL_ERROR "Numerical backend details escaped their owning libraries:\n${details}")
endif ()
message(STATUS "Numerical ownership verified in ${checked} production files")
